{
  "name": "open-vtt-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "oPeN VTT backend — Supabase database layer and Socket.IO server.",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  }
}
