SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key

# Browser origin(s) allowed to connect to Socket.IO (CORS). Comma-separate
# multiple; defaults to http://localhost:5173 (Vite dev) when unset.
# A * matches one subdomain segment (no dots or slashes). Preview deploys:
# CLIENT_ORIGIN=https://project-2-vtt-*.vercel.app
CLIENT_ORIGIN=http://localhost:5173
